@model CatalogoApp.Domain.Models.Item
@{
    ViewData["Title"] = "Agregar videojuego";
}

<section class="form-panel">
    <h1 class="page-title">Agregar videojuego</h1>
    <p class="lead">Registra un nuevo título dentro del catálogo. Esta acción requiere iniciar sesión.</p>

    <hr class="forge-divider" />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Agregar" method="post">
        <div class="mb-3">
            <label asp-for="Titulo" class="form-label">Título</label>
            <input asp-for="Titulo" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Genero" class="form-label">Género</label>
            <input asp-for="Genero" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Consola" class="form-label">Consola</label>
            <input asp-for="Consola" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Ano" class="form-label">Año</label>
            <input asp-for="Ano" type="number" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="4" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</section>
