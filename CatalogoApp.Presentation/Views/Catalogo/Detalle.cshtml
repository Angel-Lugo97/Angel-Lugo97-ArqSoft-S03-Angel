@model CatalogoApp.Domain.Models.Item
@{
    ViewData["Title"] = Model.Titulo;
    var usuarioId = Context.Session.GetInt32("UsuarioId");
    var resenas = Model.Resenas ?? new List<CatalogoApp.Domain.Models.Resena>();
}

<section class="detail-panel">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <span class="badge bg-success mb-3">@Model.Genero</span>
            <h1 class="page-title">@Model.Titulo</h1>
            <p class="game-meta">@Model.Consola · @Model.Ano</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-secondary" asp-action="Index">← Volver</a>
            @if (usuarioId != null)
            {
                <a class="btn btn-primary" asp-controller="Resenas" asp-action="Agregar" asp-route-itemId="@Model.Id">Reseñar</a>
            }
            else
            {
                <a class="btn btn-outline-light custom-outline" asp-controller="Usuarios" asp-action="Login" asp-route-returnUrl='@($"/Resenas/Agregar?itemId={Model.Id}")'>Inicia sesión para reseñar</a>
            }
        </div>
    </div>

    <hr class="forge-divider" />

    <p class="lead">@Model.Descripcion</p>
</section>

<section class="content-panel">
    <h2 class="section-title">Reseñas</h2>

    @if (resenas.Count == 0)
    {
        <div class="review-card">
            <p class="mb-0">Todavía no hay reseñas para este videojuego.</p>
        </div>
    }
    else
    {
        @foreach (var resena in resenas.OrderByDescending(r => r.Fecha))
        {
            <article class="review-card">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <strong>@resena.UsuarioNombre</strong>
                    <span class="rating">★ @resena.Calificacion / 5</span>
                </div>
                <p class="mt-3 mb-2">@resena.Comentario</p>
                <small class="text-muted">@resena.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
            </article>
        }
    }
</section>
