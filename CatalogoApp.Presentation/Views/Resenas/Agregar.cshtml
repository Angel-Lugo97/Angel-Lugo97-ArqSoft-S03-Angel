@model CatalogoApp.Domain.Models.Resena
@{
    ViewData["Title"] = "Agregar reseña";
    var item = ViewBag.Item as CatalogoApp.Domain.Models.Item;
}

<section class="form-panel">
    <h1 class="page-title">Agregar reseña</h1>
    <p class="lead">Estás reseñando: <strong>@item?.Titulo</strong></p>

    <hr class="forge-divider" />

    <form asp-action="Agregar" method="post">
        <input asp-for="ItemId" type="hidden" />

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <div class="mb-3">
            <label asp-for="Calificacion" class="form-label">Calificación</label>
            <select asp-for="Calificacion" class="form-select" required>
                <option value="5">5 - Excelente</option>
                <option value="4">4 - Muy bueno</option>
                <option value="3">3 - Bueno</option>
                <option value="2">2 - Regular</option>
                <option value="1">1 - Malo</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Comentario" class="form-label">Comentario</label>
            <textarea asp-for="Comentario" class="form-control" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Guardar reseña</button>
        <a asp-controller="Catalogo" asp-action="Detalle" asp-route-id="@Model.ItemId" class="btn btn-secondary">Cancelar</a>
    </form>
</section>
