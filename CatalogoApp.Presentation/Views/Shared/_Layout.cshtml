@{
    var usuarioNombre = Context.Session.GetString("UsuarioNombre");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Catalogo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Catalogo" asp-action="Index">Catalogo</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPrincipal"
                    aria-controls="navbarPrincipal" aria-expanded="false" aria-label="Mostrar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarPrincipal">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Catalogo" asp-action="Index">Catálogo</a>
                    </li>
                    <li class="nav-item">
                        @if (!string.IsNullOrWhiteSpace(usuarioNombre))
                        {
                            <a class="nav-link" asp-controller="Catalogo" asp-action="Agregar">Agregar</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Usuarios" asp-action="Login" asp-route-returnUrl="/Catalogo/Agregar">Agregar</a>
                        }
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-lg-center">
                    @if (!string.IsNullOrWhiteSpace(usuarioNombre))
                    {
                        <li class="nav-item me-lg-2 my-2 my-lg-0">
                            <span class="user-pill">Hola, @usuarioNombre</span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm custom-outline" asp-controller="Usuarios" asp-action="Logout">Cerrar sesión</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-lg-2 my-2 my-lg-0">
                            <a class="btn btn-outline-light btn-sm custom-outline" asp-controller="Usuarios" asp-action="Login">Iniciar sesión</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-secondary btn-sm" asp-controller="Usuarios" asp-action="Registro">Registrarse</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @RenderBody()
    </main>
</div>

<footer class="footer">
    <div class="container">
        &copy; 2026 - Catalogo -
        <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
